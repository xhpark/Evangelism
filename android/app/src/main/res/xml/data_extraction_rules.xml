<?xml version="1.0" encoding="utf-8"?>
<!--
  라이선스 활성화 상태와 기기 고유 코드가 백업/복원을 통해
  다른 단말기로 옮겨가면 인증 게이트가 무력화되므로 전면 차단한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
